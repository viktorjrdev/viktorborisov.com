<!-- ============ CONTACT ============ -->
<section id="contact">
  <div class="container">
    <div class="section-meta">
      <span class="dot"></span>
      <span>(05) — Contact</span>
    </div>

    <div class="contact-card reveal">
      <div class="contact-grid">
        <div>
          <h2 class="contact-headline">Let's <em>talk</em>.</h2>
          <p class="contact-sub">
            Available for consultations with companies and individuals on compliance, financial crime, ISO 27001 information-security audits, investigations, and regulatory affairs.
          </p>

          <div class="contact-methods">
            <div class="contact-method">
              <span class="contact-method-label">Electronic mail</span>
              <a href="mailto:viktor.llm@yahoo.com">viktor.llm@yahoo.com</a>
            </div>
            <div class="contact-method">
              <span class="contact-method-label">LinkedIn</span>
              <a href="https://www.linkedin.com/in/viktor-borisov" target="_blank" rel="noopener">/in/viktor-borisov</a>
            </div>
            <div class="contact-method">
              <span class="contact-method-label">Located in</span>
              <span>Burgas / Sofia, Bulgaria</span>
            </div>
          </div>
        </div>

        <!--
          CONTACT FORM:
          This form uses a mailto: handler — when the visitor clicks "Send message",
          it opens their default email client (Outlook, Mail, Gmail web, etc.) with
          the message pre-filled and addressed to viktor.llm@yahoo.com. The visitor
          just needs to confirm and send.

          This works out of the box without any backend or signup. If you'd prefer
          a true server-side form (so visitors send without their own email client),
          replace the JS handler at the bottom of the file with a Formspree or
          Netlify Forms endpoint — instructions in the comment there.
        -->
        <form class="contact-form" id="contactForm" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" placeholder="Your full name" required>
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" placeholder="you@firm.com" required>
            </div>
          </div>

          <div class="form-field form-field--full">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" type="text" placeholder="Opportunity, question, or note">
          </div>

          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell me what you're working on." required></textarea>
          </div>

          <button class="submit-btn" type="submit">Send message</button>
          <div class="form-status" id="formStatus"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer>
  <div class="container">
    <div class="footer-inner">
      <div>© MMXXVI · Viktor Borisov</div>
    </div>
  </div>
</footer>

<script>
  // ============ Reveal-on-scroll ============
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  document.querySelectorAll('.role').forEach((el, i) => {
    el.style.transitionDelay = (i * 90) + 'ms';
  });
  document.querySelectorAll('.edu-card').forEach((el, i) => {
    el.style.transitionDelay = (i * 120) + 'ms';
  });
  document.querySelectorAll('.expertise-card').forEach((el, i) => {
    el.style.transitionDelay = (i * 100) + 'ms';
  });

  // ============ Enhanced "Get in touch" navigation ============
  // Smooth-scroll to the contact section accounting for the fixed nav height,
  // then add a subtle highlight pulse so visitors know they've arrived.
  function smoothScrollToContact(e) {
    e.preventDefault();
    const target = document.getElementById('contact');
    if (!target) return;

    // Nav is ~70px tall + 16px offset; leave 24px breathing room
    const navOffset = 100;
    const top = target.getBoundingClientRect().top + window.pageYOffset - navOffset;

    window.scrollTo({ top, behavior: 'smooth' });

    // Add a brief highlight pulse to the contact card on arrival
    const card = target.querySelector('.contact-card');
    if (card) {
      setTimeout(() => {
        card.classList.add('arrived');
        setTimeout(() => card.classList.remove('arrived'), 1400);
      }, 700);
    }

    // Focus the first form input after scrolling completes (nice UX touch)
    setTimeout(() => {
      const firstInput = document.getElementById('name');
      if (firstInput && window.matchMedia('(min-width: 900px)').matches) {
        firstInput.focus({ preventScroll: true });
      }
    }, 1000);
  }

  // Wire all "Get in touch" CTAs (nav + hero portrait)
  document.querySelectorAll('a[href="#contact"]').forEach(link => {
    link.addEventListener('click', smoothScrollToContact);
  });

  // ============ Contact form — mailto handler ============
  // This opens the visitor's default mail client with the message pre-filled,
  // addressed to viktor.llm@yahoo.com. Works without any backend setup.
  //
  // TO SWITCH TO A REAL BACKEND (so visitors send without their email client):
  //  1. Sign up for Formspree (formspree.io) or Netlify Forms (free tier).
  //  2. Replace the submit handler below with their snippet.
  //  3. For Formspree: change <form> tag to <form action="https://formspree.io/f/YOUR_ID" method="POST">
  //
  const form = document.getElementById('contactForm');
  const status = document.getElementById('formStatus');

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const subject = document.getElementById('subject').value.trim() || 'Inquiry via your portfolio';
    const message = document.getElementById('message').value.trim();

    // basic validation
    if (!name || !email || !message) {
      status.textContent = '· Please fill in name, email, and message.';
      status.style.color = '#F5D547';
      status.classList.add('visible');
      return;
    }

    // build mailto link
    const body = `From: ${name}\nEmail: ${email}\n\n${message}\n\n—\nSent via viktorborisov.com portfolio`;
    const mailto = 'mailto:viktor.llm@yahoo.com'
      + '?subject=' + encodeURIComponent(subject)
      + '&body=' + encodeURIComponent(body);

    // open mail client
    window.location.href = mailto;

    // confirmation
    status.textContent = '· Opening your email client…';
    status.style.color = 'var(--lime)';
    status.classList.add('visible');

    setTimeout(() => {
      status.classList.remove('visible');
    }, 5000);
  });
</script>

</body>
</html>
